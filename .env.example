# Used ONLY by backend/evals/record.py (re-recording fixtures) and CLI scripts.
# The web app never uses a server key: each visitor enters their own key in the UI.
GROQ_API_KEY=
# Answers. Keep 20b if 120b is tight on your free tier.
GROQ_MODEL=openai/gpt-oss-120b
# Graph extraction + community summaries. Cheap on purpose.
EXTRACTION_MODEL=openai/gpt-oss-20b

# Seed the bundled sample corpus on first run (replayed LLM output, 0 API calls).
SEED_DEMO=1

# Require "Authorization: Bearer <token>" on every API route except /api/health.
# Leave empty for local development.
API_TOKEN=

# Storage: everything lives in one SQLite file at $DATA_DIR/app.db
DATA_DIR=data

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Extraction batching and community summary budget
EXTRACTION_BATCH_SIZE=3
MAX_LLM_SUMMARIES=6

# Uploads
MAX_UPLOAD_BYTES=10485760

# Dev only: browser origin allowed to call the API (Next dev server)
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Frontend build-time: empty means same origin (production). For `npm run dev`
# set NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_API_BASE=
